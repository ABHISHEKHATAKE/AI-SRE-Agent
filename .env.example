GROQ_API_KEY=             # console.groq.com
API_KEY=                  # protects all /api write/investigate endpoints; REQUIRED in production
TELEMETRY_SOURCE=sim      # sim | real
PROM_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
GITHUB_REPO=org/repo
GITHUB_TOKEN=             # read-only token
DATABASE_URL=             # postgresql://user:pass@host/db (default: SQLite)
SLACK_WEBHOOK_URL=
MAX_CONCURRENT=4
DEDUPE_SECONDS=600
RATE_LIMIT_PER_MIN=60
REDACT=1
THRESHOLDS={}             # e.g. {"cpu":85,"mem_growth":0.3,"min_sources":2}
PROM_QUERIES={}           # override PromQL per metric; {service} is substituted
LIVE_ENABLED=1            # set 0 in real production (disables the demo stack)
